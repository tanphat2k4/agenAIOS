# PostgreSQL connection (psycopg 3 driver). Copy this file to `.env` and adjust.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentaios

# JWT signing — replace with a long random string in production.
SECRET_KEY=dev-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated allowed CORS origins (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 9Router LLM gateway (OpenAI-compatible). Empty key works on loopback; set a key for remote/Tailscale.
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_DEFAULT_MODEL=fast-chat
